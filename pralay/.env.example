# Application
APP_NAME=Pralay Flash Flood Prediction System
APP_VERSION=0.1.0
DEBUG=True
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
POSTGRES_USER=pralay_user
POSTGRES_PASSWORD=pralay_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pralay_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=False

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# External APIs
IMD_API_URL=https://mausam.imd.gov.in/imd_latest/contents/api
IMD_API_KEY=your_imd_api_key_here

# ML Model Paths
MODEL_DIR=./ml/models/trained
LSTM_MODEL_PATH=./ml/models/trained/lstm_flood.pth
XGBOOST_MODEL_PATH=./ml/models/trained/xgboost_risk.pkl
ENSEMBLE_MODEL_PATH=./ml/models/trained/ensemble.pkl

# Alert Thresholds
RISK_THRESHOLD_LOW=0.3
RISK_THRESHOLD_MODERATE=0.5
RISK_THRESHOLD_HIGH=0.7
RISK_THRESHOLD_EXTREME=0.85

# Notification Services
SMS_PROVIDER_URL=
SMS_API_KEY=
FCM_SERVER_KEY=

# JWT Authentication
SECRET_KEY=change-this-secret-key-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
